page { background:#fffaf2; color:#292521; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; }.page { padding:24rpx 28rpx 60rpx; }.head { padding:28rpx; background:#263b31; color:#fffaf2; border-radius:22rpx; }.eyebrow { display:block; color:#d4aa79; font-size:18rpx; letter-spacing:3rpx; }.title { display:block; margin-top:10rpx; font-size:34rpx; font-weight:700; }.hint { display:block; margin-top:12rpx; color:#c2bbad; font-size:21rpx; }.order-card,.total-card,.finish-card { margin-top:20rpx; padding:24rpx; border-radius:18rpx; background:#fff; box-shadow:0 6rpx 22rpx #392c190b; }.order-head { display:flex; justify-content:space-between; padding-bottom:18rpx; color:#6f675d; font-size:22rpx; border-bottom:1px solid #eee7dc; }.status { color:#a3442e; font-weight:650; }.payment-row { display:flex; justify-content:space-between; margin-top:16rpx; color:#72695e; font-size:21rpx; }.payment-status.paid { color:#3e7656; font-weight:650; }.payment-status.unpaid { color:#a3442e; font-weight:650; }.line { display:flex; align-items:flex-start; gap:12rpx; padding:18rpx 0; border-bottom:1px solid #f3eee7; }.dish-copy { flex:1; min-width:0; }.dish { display:block; font-size:25rpx; font-weight:600; }.sub { display:block; margin-top:6rpx; color:#90877c; font-size:20rpx; }.quantity { color:#746c61; font-size:22rpx; }.amount { width:130rpx; flex:none; text-align:right; font-size:23rpx; }.total { display:flex; justify-content:space-between; margin-top:18rpx; font-size:24rpx; font-weight:650; }.total-card { display:flex; justify-content:space-between; align-items:center; font-size:25rpx; font-weight:650; flex-wrap:wrap; }.price { color:#a3442e; font-size:32rpx; }.block { width:100%; color:#8e8579; font-weight:400; }.empty { padding:100rpx 0; display:flex; align-items:center; flex-direction:column; color:#8b8277; }.empty-icon { font-size:70rpx; margin-bottom:20rpx; }.go-menu,.refresh,.pay-button,.finish-button { margin-top:26rpx; background:#f2e8db; color:#7a3a2c; border-radius:40rpx; font-size:24rpx; }.pay-button,.finish-button { width:100%; background:#a3442e; color:#fffaf2; }.finish-card { text-align:center; }.finish-title { display:block; font-size:27rpx; font-weight:700; }.finish-hint { display:block; margin-top:12rpx; color:#8e8579; font-size:21rpx; }.finish-button { background:#263b31; }.finish-button.finish-disabled { opacity:.42; }.refresh { width:100%; background:#263b31; color:#fffaf2; }.go-menu::after,.refresh::after,.pay-button::after,.finish-button::after { border:0; }
