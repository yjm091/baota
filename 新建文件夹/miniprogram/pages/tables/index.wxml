<view class="page">
  <view class="hero">
    <text class="eyebrow">WELCOME</text>
    <text class="title">请选择桌号</text>
    <text class="subtitle">选择一桌，开始点餐</text>
  </view>

  <view wx:if="{{loading}}" class="state-card"><view class="spinner"></view><text>正在读取餐桌…</text></view>
  <view wx:elif="{{error}}" class="state-card error-state">
    <text class="state-title">暂时无法加载桌台</text>
    <text class="state-copy">{{error}}</text>
    <button class="retry-button" bindtap="loadTables">重新加载</button>
  </view>
  <view wx:elif="{{!tables.length}}" class="state-card">
    <text class="state-title">目前没有可选桌台</text>
    <text class="state-copy">请联系餐厅工作人员确认桌台设置</text>
    <button class="retry-button" bindtap="loadTables">刷新</button>
  </view>
  <view wx:else class="table-list">
    <button wx:for="{{tables}}" wx:key="id" class="table-card {{item.occupied ? 'occupied' : 'available'}}" data-id="{{item.id}}" bindtap="chooseTable">
      <view class="table-icon">{{item.occupied ? '🍽️' : '🪑'}}</view>
      <view class="table-info">
        <text class="table-name">{{item.name}}</text>
      </view>
      <view class="table-status"><view class="status-dot"></view><text>{{item.occupied ? '用餐中' : '空闲'}}</text></view>
      <text class="arrow">›</text>
    </button>
  </view>
</view>
